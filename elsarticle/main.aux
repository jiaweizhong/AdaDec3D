\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Motivation: Decoder computation produces spatially localized prediction flips. While the full decoder corrects certain errors of the efficient baseline (positive flips), it also alters previously correct predictions (negative flips) near high-entropy organ boundaries, demonstrating non-uniform spatial utility.}}{15}{figure.1}\protected@file@percent }
\newlabel{fig:motivation}{{1}{15}{Motivation: Decoder computation produces spatially localized prediction flips. While the full decoder corrects certain errors of the efficient baseline (positive flips), it also alters previously correct predictions (negative flips) near high-entropy organ boundaries, demonstrating non-uniform spatial utility}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Voxel-level net benefit and spatial boundary concentration across architectures. Left Column: Global positive, negative, and net flip rates for (a) 3D UX-Net, (c) SwinUNETR, and (e) MedNeXt-M-K3. Right Column: Net flip rate as a function of distance to organ boundaries for (b) 3D UX-Net, (d) SwinUNETR, and (f) MedNeXt-M-K3.}}{16}{figure.2}\protected@file@percent }
\newlabel{fig:heterogeneity}{{2}{16}{Voxel-level net benefit and spatial boundary concentration across architectures. Left Column: Global positive, negative, and net flip rates for (a) 3D UX-Net, (c) SwinUNETR, and (e) MedNeXt-M-K3. Right Column: Net flip rate as a function of distance to organ boundaries for (b) 3D UX-Net, (d) SwinUNETR, and (f) MedNeXt-M-K3}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Organ-level flip breakdown across (a) 3D UX-Net, (b) SwinUNETR, and (c) MedNeXt-M-K3. Complex and small anatomical structures show high prediction volatility, whereas large organs remain stable.}}{17}{figure.3}\protected@file@percent }
\newlabel{fig:heterogeneity_anatomy}{{3}{17}{Organ-level flip breakdown across (a) 3D UX-Net, (b) SwinUNETR, and (c) MedNeXt-M-K3. Complex and small anatomical structures show high prediction volatility, whereas large organs remain stable}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Oracle concentration curves for (a) 3D UX-Net, (b) SwinUNETR, and (c) MedNeXt-M-K3, showing that 80\% of positive net benefit ($K_{80}$) is concentrated in 5\% of spatial blocks.}}{18}{figure.4}\protected@file@percent }
\newlabel{fig:concentration}{{4}{18}{Oracle concentration curves for (a) 3D UX-Net, (b) SwinUNETR, and (c) MedNeXt-M-K3, showing that 80\% of positive net benefit ($K_{80}$) is concentrated in 5\% of spatial blocks}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Inference-time flip predictability across (a) 3D UX-Net, (b) SwinUNETR, and (c) MedNeXt-M-K3. Predictive entropy reliably identifies flip locations (AUROC $>0.90$) but cannot distinguish positive corrections from negative degradations (AUROC $\approx 0.55$).}}{19}{figure.5}\protected@file@percent }
\newlabel{fig:predictability}{{5}{19}{Inference-time flip predictability across (a) 3D UX-Net, (b) SwinUNETR, and (c) MedNeXt-M-K3. Predictive entropy reliably identifies flip locations (AUROC $>0.90$) but cannot distinguish positive corrections from negative degradations (AUROC $\approx 0.55$)}{figure.5}{}}
