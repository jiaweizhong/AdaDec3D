\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Motivation: Decoder computation yields spatially localized flips. While the full decoder corrects some efficient decoder errors (positive flips), it simultaneously degrades other previously correct predictions (negative flips) at high-entropy boundaries. This illustrates that decoder computation is not uniformly beneficial.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:motivation}{{1}{14}{Motivation: Decoder computation yields spatially localized flips. While the full decoder corrects some efficient decoder errors (positive flips), it simultaneously degrades other previously correct predictions (negative flips) at high-entropy boundaries. This illustrates that decoder computation is not uniformly beneficial}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Heterogeneity. Left: Global positive and negative flip rates demonstrating net-neutral behavior. Middle: Net flip rate distributed by distance to the boundary. Right: Organ-level flip rates showing high volatility in small structures (e.g., adrenal glands).}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:heterogeneity}{{2}{15}{Heterogeneity. Left: Global positive and negative flip rates demonstrating net-neutral behavior. Middle: Net flip rate distributed by distance to the boundary. Right: Organ-level flip rates showing high volatility in small structures (e.g., adrenal glands)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Concentration. Oracle coverage curve showing that 80\% of the full decoder's net benefit is concentrated in just 5\% of the image volume.}}{15}{figure.3}\protected@file@percent }
\newlabel{fig:concentration}{{3}{15}{Concentration. Oracle coverage curve showing that 80\% of the full decoder's net benefit is concentrated in just 5\% of the image volume}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Predictability. Entropy highly discriminates flip locations (instability, AUROC 0.903) but fails to distinguish positive corrections from negative degradations (AUROC 0.592).}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:predictability}{{4}{16}{Predictability. Entropy highly discriminates flip locations (instability, AUROC 0.903) but fails to distinguish positive corrections from negative degradations (AUROC 0.592)}{figure.4}{}}
