\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Conditional entropy density distributions for positive corrections ($P$) and negative degradations ($N$). Overlapping distributions demonstrate why scalar uncertainty signals fail to predict directional net gain.}}{9}{figure.6}\protected@file@percent }
